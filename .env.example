# Milestone Yearbook - Environment Configuration Example
# Copy this file to .env and fill in the values.

# ==================================================
# 1. CORE APPLICATION (REQUIRED)
# ==================================================
VITE_APP_URL=http://yearbook-manager.test
PORT=8080
HOST_PORT=8088

# ==================================================
# 2. LOCAL STACK / DATA BACKEND (REQUIRED)
# ==================================================
# Options: 'local' (Self-contained Docker PostgreSQL + local storage) or 'supabase' (Cloud fallback)
DATA_BACKEND=local
DATABASE_URL=postgresql://yearbook_user:yearbook_secure_pass@postgres:5432/yearbook_db
POSTGRES_USER=yearbook_user
POSTGRES_PASSWORD=yearbook_secure_pass
POSTGRES_DB=yearbook_db
STORAGE_LOCAL_PATH=/data/storage
JWT_SECRET=super-secret-local-jwt-token-key-32b
SESSION_SECRET=super-secret-local-session-secret-key-32b

# ==================================================
# 3. SUPABASE (PRESERVED FOR FALLBACK)
# ==================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ==================================================
# 4. SECURITY / CREDENTIAL VAULT (REQUIRED)
# ==================================================
MILESTONE_PROVIDER_SECRET=12345678901234567890123456789012

# ==================================================
# 5. EXTERNAL DIRECT PROVIDERS (OPTIONAL)
# ==================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Milestone Yearbook - Environment Configuration Example
# Copy this file to .env and fill in the values.

# --- SUPABASE (REQUIRED) ---
# Your Supabase project URL and public API key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service role key is required for server functions to bypass RLS for administrative tasks.
# NEVER expose this key on the client side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- APPLICATION (REQUIRED) ---
# The base URL of your application. Used for OAuth callbacks.
# Local: http://localhost:8080
# Production: https://your-domain.app
VITE_APP_URL=http://localhost:8080
NODE_ENV=development

# --- SECURITY (REQUIRED) ---
# A 32-character base64-encoded secret used for AES-256-GCM encryption of provider tokens.
# Generate one using: openssl rand -base64 32
MILESTONE_PROVIDER_SECRET=your-32-byte-base64-secret

# --- GOOGLE DRIVE (OPTIONAL - STANDALONE) ---
# To use Google Drive without Lovable Managed Connectors, provide these:
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- BOX (OPTIONAL) ---
# Required for Box integration.
BOX_CLIENT_ID=your-box-client-id
BOX_CLIENT_SECRET=your-box-client-secret

# --- CANVA (OPTIONAL) ---
# Required for Canva integration.
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret

# --- LOVABLE-SPECIFIC (TO BE REPLACED) ---
# These are used by the Managed Connector Gateway and can be removed after migration.
# LOVABLE_API_KEY=
# GOOGLE_DRIVE_API_KEY=

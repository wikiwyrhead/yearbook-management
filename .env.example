# Milestone Yearbook — Environment Configuration Example
# Copy this file to .env and fill in all values before starting the server.
# DO NOT commit your actual .env file — it is listed in .gitignore.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ==================================================
# 1. CORE APPLICATION (REQUIRED)
# ==================================================
VITE_APP_URL=http://yearbook-manager.test
PORT=8080
HOST_PORT=8088

# ==================================================
# 2. LOCAL STACK / DATA BACKEND (REQUIRED)
# ==================================================
# Options: 'local' (self-contained Docker PostgreSQL + local storage) or 'supabase' (cloud fallback)
DATA_BACKEND=local

# PostgreSQL — set your own strong password, then run: docker compose up -d
DATABASE_URL=postgresql://yearbook_user:<YOUR_POSTGRES_PASSWORD>@postgres:5432/yearbook_db
POSTGRES_USER=yearbook_user
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_DB=yearbook_db

STORAGE_LOCAL_PATH=/data/storage

# JWT / Session — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<GENERATE_WITH_CRYPTO_RANDOM_BYTES_32>
SESSION_SECRET=<GENERATE_WITH_CRYPTO_RANDOM_BYTES_32>

# ==================================================
# 3. SUPABASE (PRESERVED FOR FALLBACK — OPTIONAL)
# ==================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ==================================================
# 4. SECURITY / CREDENTIAL VAULT (REQUIRED)
# ==================================================
# AES-256-GCM key for encrypting provider OAuth tokens at rest.
# MUST be exactly 32 bytes hex (64 hex chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MILESTONE_PROVIDER_SECRET=<GENERATE_64_HEX_CHARS_WITH_CRYPTO_RANDOM_BYTES_32>

# ==================================================
# 5. EXTERNAL DIRECT PROVIDERS (OPTIONAL)
# ==================================================
# Google Drive API v3 — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Box API v2 — https://developer.box.com/
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# Canva Connect API — https://www.canva.com/developers/
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

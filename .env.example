# Milestone Yearbook - Environment Configuration Example
# Copy this file to .env and fill in the values.

# ==================================================
# 1. CORE APPLICATION (REQUIRED)
# ==================================================
# Canonical application base URL used for OAuth redirects, auth emails, and routing.
VITE_APP_URL=http://yearbook-manager.test
NODE_ENV=development

# Internal container listening port (Node.js SSR server). Keep 8080.
PORT=8080

# Host port exposed by Docker Compose:
# Set to 80 for direct access at http://yearbook-manager.test (standard HTTP)
# Set to 8080 or custom port (e.g. 8088) if port 80 is already occupied on your host.
HOST_PORT=80

# ==================================================
# 2. SUPABASE / DATABASE (REQUIRED)
# ==================================================
# Public Supabase URL and anonymous key for client authentication.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Server-only service role key for admin tasks / background jobs (NEVER expose to client).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==================================================
# 3. SECURITY / CREDENTIAL VAULT (REQUIRED)
# ==================================================
# A 32-byte base64-encoded secret for AES-256-GCM token encryption.
# Generate one using: openssl rand -base64 32
MILESTONE_PROVIDER_SECRET=your-32-byte-base64-secret

# ==================================================
# 4. GOOGLE DRIVE (OPTIONAL - DIRECT STANDALONE)
# ==================================================
# Direct Google Drive API v3 OAuth credentials.
# OAuth redirect URI: http://yearbook-manager.test/api/public/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==================================================
# 5. BOX (OPTIONAL - DIRECT STANDALONE)
# ==================================================
# Box Content API v2 OAuth credentials.
# OAuth redirect URI: http://yearbook-manager.test/api/public/auth/callback
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# ==================================================
# 6. CANVA (OPTIONAL - DIRECT STANDALONE)
# ==================================================
# Canva Connect API OAuth credentials with PKCE.
# OAuth redirect URI: http://yearbook-manager.test/api/public/auth/callback
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

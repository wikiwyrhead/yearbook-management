# =====================================================
# LOGS
# =====================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =====================================================
# DEPENDENCIES & BUILD OUTPUT
# =====================================================
node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro

# =====================================================
# ENVIRONMENT & SECRETS — NEVER COMMIT THESE
# =====================================================
.env
.env.*
!.env.example
.dev.vars

# Local dev credentials, test account passwords, generated assets
.localdev
.localdev/*

# AES / crypto key files
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der

# Service account / OAuth credential JSON dumps
service-account*.json
*-credentials.json
*-oauth*.json
*-token*.json
client_secret*.json

# =====================================================
# CLOUDFLARE / TUNNEL
# =====================================================
# Tunnel credential JSON files (contain tunnel tokens — never commit)
*.cftoken
.wrangler/
/etc/cloudflared/

# If cloudflared config is copied into project directory
cloudflared-*.json
tunnel-*.json

# =====================================================
# EDITOR & OS FILES
# =====================================================
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# =====================================================
# LOCAL TEST ARTIFACTS (capture scripts, screenshots)
# =====================================================
screenshots/
captures/
*.screenshot.png
*.capture.png
